# Copy to .env at project root. No real credentials are shipped.
# Required: your own PostgreSQL connection. Use a NEW database for initial setup.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/xxxvii
# Public HTTP port for production; API port during local development.
PORT=8080
# Local Vite web port (export launcher only).
WEB_PORT=5173
# Optional canvas preview server (not required for the public website).
CANVAS_PORT=5174
# Comma-separated trusted browser origins. Include your actual www/apex hosts.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
# The launcher sets NODE_ENV, BASE_PATH=/, API_PORT, and SERVE_WEB.
# No SESSION_SECRET is needed: the current app has no login/session flow.
